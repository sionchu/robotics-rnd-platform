{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:robotics-rnd:workcell-exchange:1.0.0",
  "title": "Vendor-Neutral Workcell Exchange Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "workcell_id",
    "conventions",
    "frames",
    "transforms",
    "usd"
  ],
  "properties": {
    "$schema": {"const": "urn:robotics-rnd:workcell-exchange:1.0.0"},
    "schema_version": {"const": "1.0.0"},
    "workcell_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"},
    "conventions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "length_unit",
        "angle_unit",
        "quaternion_order",
        "transform_convention",
        "handedness",
        "up_axis"
      ],
      "properties": {
        "length_unit": {"const": "metre"},
        "angle_unit": {"const": "radian"},
        "quaternion_order": {"const": "xyzw"},
        "transform_convention": {"const": "T_target_source"},
        "handedness": {"const": "right-handed"},
        "up_axis": {"const": "Z"}
      }
    },
    "frames": {
      "type": "array",
      "minItems": 6,
      "items": {"$ref": "#/$defs/frame"},
      "allOf": [
        {"contains": {"properties": {"role": {"const": "world"}}, "required": ["role"]}},
        {"contains": {"properties": {"role": {"const": "robot_base"}}, "required": ["role"]}},
        {"contains": {"properties": {"role": {"const": "tool"}}, "required": ["role"]}},
        {"contains": {"properties": {"role": {"const": "camera"}}, "required": ["role"]}},
        {"contains": {"properties": {"role": {"const": "fixture"}}, "required": ["role"]}},
        {"contains": {"properties": {"role": {"const": "target"}}, "required": ["role"]}}
      ]
    },
    "transforms": {
      "type": "array",
      "minItems": 5,
      "items": {"$ref": "#/$defs/transform"}
    },
    "usd": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default_prim", "prims"],
      "properties": {
        "default_prim": {"const": "/World"},
        "prims": {
          "type": "array",
          "minItems": 5,
          "items": {"$ref": "#/$defs/usd_prim"}
        }
      }
    }
  },
  "$defs": {
    "frame_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_./-]*$"
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "parent"],
      "properties": {
        "id": {"$ref": "#/$defs/frame_id"},
        "role": {
          "enum": ["world", "robot_base", "tool", "camera", "fixture", "target"]
        },
        "parent": {
          "oneOf": [
            {"$ref": "#/$defs/frame_id"},
            {"type": "null"}
          ]
        }
      }
    },
    "finite_number": {"type": "number"},
    "translation": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/finite_number"}
    },
    "quaternion": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/finite_number"}
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "target_frame",
        "source_frame",
        "translation_m",
        "rotation_xyzw"
      ],
      "properties": {
        "name": {"type": "string", "pattern": "^T_[A-Za-z0-9_./-]+_[A-Za-z0-9_./-]+$"},
        "target_frame": {"$ref": "#/$defs/frame_id"},
        "source_frame": {"$ref": "#/$defs/frame_id"},
        "translation_m": {"$ref": "#/$defs/translation"},
        "rotation_xyzw": {"$ref": "#/$defs/quaternion"}
      }
    },
    "usd_prim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "type", "frame"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/[A-Za-z][A-Za-z0-9_]*(/[A-Za-z][A-Za-z0-9_]*)*$"
        },
        "type": {"enum": ["Xform", "Camera"]},
        "frame": {"$ref": "#/$defs/frame_id"}
      }
    }
  }
}
